{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Next.js Dev Server",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "Next.js Production Server",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "build", "&&", "npx", "next", "start"],
      "port": 3000
    }
  ]
}
